# Copy to .env and adjust. The app reads these from the environment
# (export them, or use a tool such as direnv / python-dotenv).

# Where the SQLite database file lives (default: ./nach_tracker.db)
NACH_DB_PATH=nach_tracker.db

# Charge applied per chargeable bounce event, in rupees
BOUNCE_CHARGE_AMOUNT=250.00

# Server bind address / port for `python app.py`
HOST=127.0.0.1
PORT=5000
